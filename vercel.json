{
  "version": 2,
  "ignoreCommand": "sh scripts/vercel-canonical-project-only.sh",
  "routes": [
    {
      "src": "/zargox",
      "dest": "/api/zargox-page.js"
    },
    {
      "src": "/api/zargox",
      "dest": "/api/zargox.js"
    },
    {
      "src": "/api/zargox/(.*)",
      "dest": "/api/zargox.js"
    },
    {
      "src": "/chat",
      "dest": "/api/index.js"
    },
    {
      "src": "/temporal",
      "dest": "/api/index.js"
    },
    {
      "src": "/mappa-globale",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "env": {
    "MYZUBSTER_WALLET_ADDRESS": "myz_77d6ddd05bf30e8fef178ac1b5b5e112",
    "MYZUBSTER_XMR_WALLET_ADDRESS": "xmr_641340aa6aa86029e833a5e5f5fb2b31",
    "PLATFORM_FEE": "2",
    "NODE_ENV": "production"
  }
}
