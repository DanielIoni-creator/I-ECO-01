            status: "🛸 Scoperto"
        }
    },
    "3000": {
        "Orto Botanico Galattico": {
            coordinates: [0, 0],
            species: ["Rosa Galattica", "Lilio Interstellare", "Orchidea Quantica", "Fiori di Nebulosa"],
            era: "Galattico",
            status: "🌌 Esplorato"
        }
    }
