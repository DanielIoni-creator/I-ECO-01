function getPythoResponse(message) {
    const lower = message.toLowerCase();
    let response = "default";
    
    if (lower.includes("fluffypony") || lower.includes("riccardo spagni") || lower.includes("riccardo")) {
        response = "fluffypony";
    }
    else if (lower.includes("storia monero") || lower.includes("storia di monero") || lower.includes("origine monero") || lower.includes("nascita monero")) {
        response = "storia_monero";
    }
    else if (lower.includes("privacy monero") || lower.includes("monero privacy") || lower.includes("monero anonimo")) {
        response = "privacy_monero";
    }
    else if (lower.includes("riccardo spagni") || lower.includes("spagni")) {
        response = "riccardo_spagni";
    }
    else if (lower.includes("musica") || lower.includes("canzone") || lower.includes("melodia") || lower.includes("suono")) {
        response = "musica";
    }
    else if (lower.includes("strumento") || lower.includes("chitarra") || lower.includes("pianoforte") || lower.includes("violino") || lower.includes("arpa")) {
        response = "strumenti";
    }
    else if (lower.includes("canto") || lower.includes("cantare") || lower.includes("voce")) {
        response = "canto";
    }
    else if (lower.includes("chiesa") || lower.includes("parrocchia") || lower.includes("duomo")) {
        response = "chiesa";
    }
    else if (lower.includes("monero") || lower.includes("xmr")) {
        response = "monero";
    }
    else if (lower.includes("privacy") || lower.includes("anonimo") || lower.includes("riservatezza")) {
        response = "privacy";
    }
    else if (lower.includes("myz") || lower.includes("token") || lower.includes("myzubster")) {
        response = "myz";
    }
    else if (lower.includes("blockchain") || lower.includes("crypto") || lower.includes("criptovaluta")) {
        response = "blockchain";
    }
    else if (lower.includes("ecosistema") || lower.includes("progetto") || lower.includes("piattaforma")) {
        response = "ecosistema";
    }
    else if (lower.includes("pagamento") || lower.includes("transazione") || lower.includes("acquisto")) {
        response = "pagamenti";
    }
    else if (lower.includes("pomodori") || lower.includes("pomodoro")) {
        response = "pomodori";
    }
    else if (lower.includes("help") || lower.includes("aiuto") || lower.includes("consiglio")) {
        response = "help";
    }
    else if (lower.includes("orto") || lower.includes("giardino") || lower.includes("coltivare")) {
        response = "orto";
    }
    else if (lower.includes("pianta") || lower.includes("fiore") || lower.includes("albero") || lower.includes("erba") || lower.includes("aromatica")) {
        response = "piante";
    }
    else if (lower.includes("acqua") || lower.includes("innaffiare") || lower.includes("bagnare")) {
        response = "acqua";
    }
    else if (lower.includes("concime") || lower.includes("fertilizzante") || lower.includes("nutriente")) {
        response = "concime";
    }
    else if (lower.includes("malattia") || lower.includes("funghi") || lower.includes("parassita") || lower.includes("insetto") || lower.includes("macchia")) {
        response = "malattie";
    }
    else if (lower.includes("compost") || lower.includes("riciclo")) {
        response = "compost";
    }
    else if (lower.includes("clima") || lower.includes("sole") || lower.includes("gelo") || lower.includes("freddo") || lower.includes("caldo")) {
        response = "clima";
    }
    else if (lower.includes("potatura") || lower.includes("taglia") || lower.includes("ramo") || lower.includes("polloni")) {
        response = "potatura";
    }
    else if (lower.includes("semina") || lower.includes("semi") || lower.includes("germogliare") || lower.includes("trapianto")) {
        response = "semina";
    }
    
    const responses = pythoResponses[response] || pythoResponses["default"];
    return responses[Math.floor(Math.random() * responses.length)];
}

