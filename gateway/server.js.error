// Parole chiave per ogni categoria
const chatKeywords = {
    'help': ['help', 'aiuto', 'consiglio', 'suggerimento', 'cosa fare', 'come fare', 'aiutami'],
    'orto': ['orto', 'giardino', 'coltivare', 'semina', 'piantare', 'pomodori', 'pomodoro', 'insalata', 'lattuga', 'zucchine', 'peperoni', 'melanzane', 'fagioli', 'piselli', 'carote', 'ravanelli', 'cipolle', 'aglio', 'prezzemolo', 'basilico', 'piante', 'verdura', 'ortaggio'],
    'piante': ['pianta', 'piante', 'fiore', 'albero', 'arbusto', 'perenne', 'annuale', 'bulbo', 'rizoma', 'talea', 'erba', 'cespuglio', 'ramo'],
    'acqua': ['acqua', 'innaffiare', 'irrigare', 'bagnare', 'umidità', 'umido', 'secco', 'goccia', 'pioggia'],
    'concime': ['concime', 'fertilizzante', 'nutriente', 'compost', 'letame', 'humus', 'azoto', 'fosforo', 'potassio', 'organico', 'minerale'],
    'malattie': ['malattia', 'funghi', 'parassita', 'insetto', 'afide', 'ragnetto', 'mosca', 'bruco', 'lumaca', 'chiocciola', 'macchia', 'foglia', 'marciume'],
    'compost': ['compost', 'riciclo', 'scarti', 'organico', 'decomporre', 'terreno', 'humus'],
    'clima': ['clima', 'sole', 'ombra', 'gelo', 'freddo', 'caldo', 'temperatura', 'venti', 'umidità', 'microclima', 'pioggia'],
    'potatura': ['potatura', 'tagliare', 'ramo', 'rami', 'cespuglio', 'siepe', 'albero', 'frutto'],
    'semina': ['semina', 'semi', 'piantare', 'germogliare', 'germinazione', 'trapianto', 'vaso', 'terreno'],
    'daniel': ['daniel', 'creatore', 'fondatore', 'ideatore', 'daniele', 'padre', 'inventore'],
    'issue': ['issue', 'problemi', 'bug', 'richiesta', 'feature', 'miglioramento', 'github'],
    'storia': ['storia', 'passato', 'origine', 'inizio', 'primi passi', 'nascita', 'inizio'],
    'futuro': ['futuro', 'prossimo', 'piano', 'visione', 'obiettivo', 'progetti', 'destino'],
    'piante_issue': ['pianta', 'specie', 'orto', 'botanico', 'recuperata', 'coltivazione', 'specie', 'varietà']
};

// Aggiorna la funzione getPythoResponse per usare tutte le parole chiave
function getPythoResponse(message) {
    const lower = message.toLowerCase();
    let response = 'default';
    
    // Controlla tutte le categorie
    for (const [category, words] of Object.entries(chatKeywords)) {
        if (words.some(word => lower.includes(word))) {
            response = category;
            break;
        }
    }
    
    const responses = pythoResponses[response] || pythoResponses['default'];
    return responses[Math.floor(Math.random() * responses.length)];
}

