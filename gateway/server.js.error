// ============================================
// PYTHO CHATBOT - Versione avanzata
// ============================================

// Aggiorna la funzione di riconoscimento con più parole chiave
function getPythoResponse(message) {
    const lower = message.toLowerCase();
    let response = 'default';
    
    // Parole chiave per ogni categoria
    const keywords = {
        'help': ['help', 'aiuto', 'consiglio', 'suggerimento', 'cosa fare', 'come fare'],
        'orto': ['orto', 'giardino', 'coltivare', 'semina', 'piantare', 'pomodori', 'pomodoro', 'insalata', 'lattuga', 'zucchine', 'peperoni', 'melanzane', 'fagioli', 'piselli', 'carote', 'ravanelli', 'cipolle', 'aglio', 'prezzemolo', 'basilico'],
        'piante': ['pianta', 'piante', 'fiore', 'albero', 'arbusto', 'perenne', 'annuale', 'bulbo', 'rizoma', 'talea'],
        'acqua': ['acqua', 'innaffiare', 'irrigare', 'bagnare', 'umidità', 'umido', 'secco', 'goccia', 'pioggia'],
        'concime': ['concime', 'fertilizzante', 'nutriente', 'compost', 'letame', 'humus', 'azoto', 'fosforo', 'potassio', 'organico', 'minerale'],
        'malattie': ['malattia', 'funghi', 'parassita', 'insetto', 'afide', 'ragnetto', 'mosca', 'bruco', 'lumaca', 'chiocciola', 'macchia', 'foglia'],
        'compost': ['compost', 'riciclo', 'scarti', 'organico', 'decomporre', 'terreno', 'humus'],
        'clima': ['clima', 'sole', 'ombra', 'gelo', 'freddo', 'caldo', 'temperatura', 'venti', 'umidità', 'microclima'],
        'potatura': ['potatura', 'tagliare', 'ramo', 'rami', 'cespuglio', 'siepe', 'albero', 'frutto'],
        'semina': ['semina', 'semi', 'piantare', 'germogliare', 'germinazione', 'trapianto', 'vaso', 'terreno']
    };
    
    // Verifica ogni categoria
    for (const [category, words] of Object.entries(keywords)) {
        if (words.some(word => lower.includes(word))) {
            response = category;
            break;
        }
    }
    
    // Se non ha trovato corrispondenza, controlla per parole singole
    if (response === 'default') {
        // Cerca parole comuni nell'orto
        const commonWords = ['pomodori', 'insalata', 'zucchine', 'fiori', 'piante', 'acqua', 'sole', 'terra', 'vaso', 'semi', 'germogli'];
        if (commonWords.some(word => lower.includes(word))) {
            response = 'orto';
        }
    }
    
    const responses = pythoResponses[response] || pythoResponses['default'];
    return responses[Math.floor(Math.random() * responses.length)];
}

// ============================================
// PYTHO KNOWLEDGE - Integrazione
// ============================================

const { getPythoKnowledge } = require('./pytho-knowledge.js');

// ROTTA: Chat con Pytho - Versione knowledge
app.post('/api/pytho/chat', (req, res) => {
    const { message } = req.body;
    
    if (!message) {
        return res.status(400).json({
            success: false,
            error: 'Pytho ha bisogno di un messaggio per risponderti!'
        });
    }
    
    // Usa la knowledge base
    const response = getPythoKnowledge(message);
    
    // Registra la conversazione
    temporalMemory.push({
        event: `🗣️ Chat Knowledge: "${message}" → "${response}"`,
        timestamp: new Date().toISOString()
    });
    
    res.json({
        success: true,
        message: message,
        response: response,
        pytho_says: response,
        timestamp: new Date().toISOString()
    });
});

