function getPythoResponse(message) {
    const lower = message.toLowerCase();
    let response = 'default';
    
    if (lower.includes('help') || lower.includes('aiuto')) response = 'help';
    else if (lower.includes('orto') || lower.includes('giardino')) response = 'orto';
    else if (lower.includes('pianta') || lower.includes('fiore') || lower.includes('albero')) response = 'piante';
    else if (lower.includes('acqua') || lower.includes('innaffia')) response = 'acqua';
    else if (lower.includes('concime') || lower.includes('fertilizzante') || lower.includes('nutriente')) response = 'concime';
    else if (lower.includes('malattia') || lower.includes('funghi') || lower.includes('parassita') || lower.includes('insetto')) response = 'malattie';
    else if (lower.includes('compost')) response = 'compost';
    else if (lower.includes('clima') || lower.includes('sole') || lower.includes('gelo')) response = 'clima';
    else if (lower.includes('potatura') || lower.includes('taglia')) response = 'potatura';
    else if (lower.includes('semina') || lower.includes('semi') || lower.includes('piantare')) response = 'semina';
    
    const responses = pythoResponses[response] || pythoResponses['default'];
    return responses[Math.floor(Math.random() * responses.length)];
}

// ROTTA: Chat con Pytho
app.post('/api/pytho/chat', (req, res) => {
    const { message, history } = req.body;
    
    if (!message) {
        return res.status(400).json({
            success: false,
            error: 'Pytho ha bisogno di un messaggio per risponderti!'
        });
    }
    
    const response = getPythoResponse(message);
    
    // Registra la conversazione nella memoria temporale
    temporalMemory.push({
        event: `🗣️ Chat con Pytho: "${message}" → "${response}"`,
        timestamp: new Date().toISOString()
    });
    
    res.json({
        success: true,
        message: message,
        response: response,
        pytho_says: response,
        timestamp: new Date().toISOString(),
        history: history || []
    });
});

// ROTTA: Ottieni consiglio casuale
app.get('/api/pytho/advice', (req, res) => {
    const topics = Object.keys(pythoResponses).filter(k => k !== 'default' && k !== 'help');
    const topic = topics[Math.floor(Math.random() * topics.length)];
    const responses = pythoResponses[topic] || pythoResponses['default'];
    const advice = responses[Math.floor(Math.random() * responses.length)];
    
    res.json({
        success: true,
        topic: topic,
        advice: advice,
        pytho_says: advice,
        timestamp: new Date().toISOString()
    });
});

