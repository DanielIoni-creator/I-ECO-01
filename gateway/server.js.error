// ============================================
// PYTHO AI - Integrazione con modello locale
// ============================================

const { getPythoAIResponse } = require('./pytho-ai.js');

// ROTTA: Chat con Pytho - Versione AI
app.post('/api/pytho/chat', async (req, res) => {
    const { message, history = [] } = req.body;
    
    if (!message) {
        return res.status(400).json({
            success: false,
            error: 'Pytho ha bisogno di un messaggio per risponderti!'
        });
    }
    
    try {
        // Ottieni risposta dall'AI
        const response = await getPythoAIResponse(message, history);
        
        // Registra la conversazione
        temporalMemory.push({
            event: `🧠 Chat AI: "${message}" → "${response.substring(0, 100)}..."`,
            timestamp: new Date().toISOString()
        });
        
        res.json({
            success: true,
            message: message,
            response: response,
            pytho_says: response,
            timestamp: new Date().toISOString(),
            history: [...history, { role: 'user', content: message }, { role: 'assistant', content: response }]
        });
    } catch (error) {
        console.error('Errore chat:', error);
        res.status(500).json({
            success: false,
            error: 'Pytho ha avuto un problema, riprova più tardi.'
        });
    }
});
